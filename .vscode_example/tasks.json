{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NativeSim",
            "type": "shell",
            "command": "west build -p auto -b native_sim ./app",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the Zephyr project using native_sim POSIX board"
        },
        {
            "label": "Build EL02",
            "type": "shell",
            "command": "west build -p auto -b esp32s3_pm_hw_02/esp32s3/procpu --sysbuild ./app",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the Zephyr project using ESP32S3 PM HW02 with MCUboot (sysbuild: build/mcuboot and build/app)"
        },
        {
            "label": "Build EL02 Bench",
            "type": "shell",
            "command": "west build -d build_bench -p auto -b esp32s3_pm_hw_02/esp32s3/procpu --sysbuild ./app -- -DEXTRA_CONF_FILE=bench.conf",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Bench build (shell, SMP over the console, stack reports) in build_bench, with MCUboot"
        },
        {
            "label": "Build STM32H7",
            "type": "shell",
            "command": "west build -p auto -b devebox_stm32h743_hw_20 ./app",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the Zephyr project using DeveBox stm32h743_hw_20 board"
        },
        {
            "label": "Build H753ZI",
            "type": "shell",
            "command": "west build -p auto -b nucleo_h753zi ./app",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the Zephyr project using nucleo_h753zi board"
        },
        {
            "label": "Build ESP32S3",
            "type": "shell",
            "command": "west build -p auto -b esp32s3_devkitc/esp32s3/procpu --sysbuild ./app -- -DOPENOCD=/home/ubuntu/zephyr/workspace/project/tools/openocd-esp32/bin/openocd -DOPENOCD_DEFAULT_PATH=/home/ubuntu/zephyr/workspace/project/tools/openocd-esp32/share/openocd/scripts",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the Zephyr project using ESP32S3 Devkit-C with MCUboot (sysbuild)"
        },
        {
            "label": "Check image sizes",
            "type": "shell",
            "command": "scripts/check_image_sizes.py build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "detail": "MCUboot against its boot partition and the signed application against slot0 minus the swap trailer, for the last ESP32 build (runs at the end of every sysbuild build)"
        },
        {
            "label": "Build QEMU Cortex A9",
            "type": "shell",
            "command": "west build -p auto -b qemu_cortex_a9 ./app",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the Zephyr project using QEMU Cortex A9"
        },
        {
            "label": "Run DBG Server",
            "group": "build",
            "detail": "Prepare debugserver for QEMU. Press F5",
            "type": "shell",
			"command": "ninja debugserver -C build -v",
            "args": [
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
            },
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": false
                }
            }
        },
        {
            "label": "Run Emulator",
            "type": "shell",
            "command": "west build -t run",
            "group": "none",
            "detail": "Run the Zephyr project using latest build"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "west twister -c --disable-warnings-as-errors -j 4 -O ./twister-out -T ./modules/eerie_leap_rt_core/tests",
            "group": "none",
            "detail": "Run rt_core tests using twister (-j caps parallel builds and QEMU instances)"
        },
        {
            "label": "Format: check",
            "type": "shell",
            "command": "scripts/format.sh",
            "group": "none",
            "problemMatcher": [],
            "detail": "Check the tracked C/C++ files against .clang-format",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Format: check changed",
            "type": "shell",
            "command": "scripts/format.sh --changed",
            "group": "none",
            "problemMatcher": [],
            "detail": "Check only the C/C++ files changed since origin/main",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Format: fix",
            "type": "shell",
            "command": "scripts/format.sh --fix",
            "group": "none",
            "problemMatcher": [],
            "detail": "Reformat the tracked C/C++ files with clang-format",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Lint: build database",
            "type": "shell",
            "command": "scripts/tidy.sh --build",
            "group": "none",
            "problemMatcher": [],
            "detail": "Build the app for native_sim into build/tidy, then lint every source with clang-tidy",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Lint: changed",
            "type": "shell",
            "command": "scripts/tidy.sh --changed",
            "group": "none",
            "problemMatcher": [],
            "detail": "Lint only the sources changed since origin/main",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Lint: all",
            "type": "shell",
            "command": "scripts/tidy.sh",
            "group": "none",
            "problemMatcher": [],
            "detail": "Lint every source with the existing build/tidy database",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rm -rf ./build",
            "group": "none",
            "detail": "Clean up the build directory"
        }
    ]
}
